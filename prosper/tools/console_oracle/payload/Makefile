# Build and send the lib_oracle payload with the ps5-payload-sdk.
#
# cases_data.h is generated by ../run_oracle.py from a cases file; do not run make by hand without it.
#   PS5_PAYLOAD_SDK  installed SDK root (required)
#   PS5_HOST/PORT    the console's ELF loader (test target only)

PS5_HOST ?= ps5
PS5_PORT ?= 9021

ifdef PS5_PAYLOAD_SDK
    include $(PS5_PAYLOAD_SDK)/toolchain/prospero.mk
else
    $(error PS5_PAYLOAD_SDK is undefined)
endif

ELF    := lib_oracle.elf
CFLAGS := -Wall -Werror -g -rdynamic

all: $(ELF)

$(ELF): lib_oracle.c cases_data.h
	$(CC) $(CFLAGS) -o $@ lib_oracle.c

clean:
	rm -f $(ELF) cases_data.h

test: $(ELF)
	$(PS5_DEPLOY) -h $(PS5_HOST) -p $(PS5_PORT) $(ELF)
