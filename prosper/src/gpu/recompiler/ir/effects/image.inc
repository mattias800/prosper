// ISA 70648 8.2 (Tables 42-44, 48), 12.16 and Table 101; llvm-mc gfx1030/gfx1013.
// CONFIDENCE: HIGH for described rows. CD encodings are recognized, but not specified by 70648.
enum ImageFlags : uint8_t {
    kImageSampler = 1u << 0,
    kImageOffset = 1u << 1,
    kImageBias = 1u << 2,
    kImageCompare = 1u << 3,
    kImageDerivatives = 1u << 4,
    kImageG16 = 1u << 5,
    kImageTail = 1u << 6,
};
constexpr Rdna2InstructionEffects image(const char* name, MA access, AD address, MD data,
                                        uint8_t flags = 0) {
    auto e = memory(name, access, address, 0, 0);
    e.memory.data = data;
    e.memory.ssrc_dwords[1] = 8;
    e.memory.ssrc_dwords[2] = (flags & kImageSampler) ? 4 : 0;
    e.memory.image_sampler = (flags & kImageSampler) != 0;
    e.memory.image_offset = (flags & kImageOffset) != 0;
    e.memory.image_bias = (flags & kImageBias) != 0;
    e.memory.image_compare = (flags & kImageCompare) != 0;
    e.memory.image_derivatives = (flags & kImageDerivatives) != 0;
    e.memory.image_g16 = (flags & kImageG16) != 0;
    e.memory.image_tail = (flags & kImageTail) != 0;
    e.memory.write_if_glc = access == MA::Atomic;
    e.memory.status = true;
    return e;
}
constexpr Rdna2InstructionEffects bvh(const char* name, AD address) {
    auto e = memory(name, MA::Load, address, 0, 4);
    e.memory.ssrc_dwords[1] = 4;
    return e;
}
