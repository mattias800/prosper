# ---- Game dumps: copyrighted, huge, NEVER commit ----
# Any PS5 title dump at the repo root is <TITLEID>-app0. Generic pattern catches every game
# (PPSA24651 = The Messenger / Unity; PPSA17942 = an Unreal Engine 4 title; + any future ones);
# explicit entries kept for clarity.
/*-app0/
/*-app0
/PPSA24651-app0/
/PPSA24651-app0
/PPSA17942-app0/
/PPSA17942-app0
*.prx
*.sprx
*.self
eboot.bin
*.prgcap
*.prgtl

# ---- Build output ----
/prosper/build/
build/
build-*/
prosper/build-*/
*.o
*.obj
*.exe
*.dll
*.so
*.a
*.lib
compile_commands.json

# ---- Third-party data not for redistribution (fetch via tools/fetch_niddb.sh) ----
/prosper/data/known_names.txt

# ---- Editor / OS ----
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Rendered screenshot artifacts (viewable locally, NEVER committed — game imagery). The renderer can
# drop frame_*.bmp/.png into whatever cwd it runs from, including the repo root, so cover it here too.
prosper/screenshots/
*.spv
*.bmp
frame_*.png

# Local universal MoltenVK for the macOS (Rosetta/x86_64) app build — not committed
/.macos-vulkan/

# Python bytecode from tools/ scripts (e.g. tools/hostprof, tools/snapshot)
__pycache__/
*.pyc
